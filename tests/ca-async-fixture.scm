(use-modules (guix derivations)
             (guix store)
             (guix ca)
             (guix packages)
             (ice-9 match)
             (rnrs io ports))
(define store (open-connection))
(set-build-options store #:use-substitutes? #t #:max-build-jobs 1
                   #:substitute-urls (list (getenv "GOONIX_ASYNC_URL")))
(define (realised d) (realised-output-path store d "out"))
(define shell (add-to-store store "async-shell" #t "sha256"
                            (getenv "GOONIX_SHELL_SOURCE")))
(define* (ca name script #:key (addressing 'content) (env '()))
  (derivation store name shell `("-c" ,script)
              #:sources (list shell)
              #:env-vars env
              #:addressing addressing))
(define (write-data p v)
  (call-with-output-file p (lambda (o) (write v o) (newline o))))
(define (silent)
  (let* ((root (getenv "GOONIX_ASYNC_ROOT"))
         (slow (ca "async-slow" "printf slow > \"$out\""))
         (other (ca "async-other"
                    (format #f "echo builder >> '~a/events'; echo builder > $out" root)
                    #:addressing 'input)))
    (call-with-output-file (string-append root "/paths")
      (lambda (port)
        (write `((slow ,(derivation->output-path slow))
                 (other ,(derivation->output-path other))) port)))
    (build-derivations store (list slow other))
    (write-data (string-append root "/result")
                `((slow ,(realised slow)) (other ,(realised other))))))
(define (dead)
  (let* ((root (getenv "GOONIX_ASYNC_ROOT"))
         (a (ca "async-dead" "printf dead-fallback > \"$out\""))
         (b (ca "async-next" "printf next > \"$out\"")))
    (build-derivations store (list a b))
    (write-data (string-append root "/dead-result")
                `((a ,(realised a)) (b ,(realised b))))))
(match (command-line)
  ((_ "silent" _) (silent))
  ((_ "dead" _) (dead)))
(close-connection store)

cabal-version:      3.4
name:               guix-daemon-hs
version:            0.1.0.0
synopsis:           Compatible build daemon for goonix
license:            GPL-3.0-or-later
build-type:         Simple
extra-source-files: src/Goonix/*.hs make-config.scm

common warnings
    default-language: GHC2024
    default-extensions: StrictData
    ghc-options: -Wall -Wcompat -Widentities -Wredundant-constraints

library
    import: warnings
    hs-source-dirs: src
    exposed-modules:
        Goonix.Config
        Goonix.Store.Base32
        Goonix.Store.Config
        Goonix.Store.Database
        Goonix.Store.Derivation
        Goonix.Store.Hash
        Goonix.Store.Nar
        Goonix.Store.Path
        Goonix.Store.ReadOnly
        Goonix.Store.References
        Goonix.Store.Server
        Goonix.Store.Settings
        Goonix.Store.Socket
        Goonix.Store.Substitute
        Goonix.Store.Wire
        Goonix.Store.Files
        Goonix.Store.Writing
        Goonix.Store.Archive
        Goonix.Store.Collector
        Goonix.Build.Engine
        Goonix.Build.Offload
        Goonix.Build.Seccomp
        Goonix.Build.Runtime
        Goonix.Build.Sandbox
        Goonix.Build.Scheduler
        Goonix.Build.Users
    c-sources: cbits/sockets.c cbits/files.c cbits/helpers.c cbits/logs.c
    extra-libraries: gcrypt sqlite3 z bz2
    build-depends:
        base >=4.20 && <5,
        bytestring >=0.12,
        containers >=0.7,
        directory >=1.3,
        filepath,
        process >=1.6,
        unix >=2.8,
        time >=1.12,
        stm >=2.5 && <2.6

test-suite build-users
    import: warnings
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: build-users.hs
    build-depends:
        base,
        bytestring,
        containers,
        guix-daemon-hs

executable guix-daemon
    import: warnings
    hs-source-dirs: app
    main-is: Main.hs
    ghc-options: -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base,
        bytestring,
        containers,
        unix,
        guix-daemon-hs

executable goonix-wire-proxy
    import: warnings
    hs-source-dirs: proxy
    main-is: Main.hs
    ghc-options: -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base,
        bytestring,
        containers,
        network,
        unix,
        stm >=2.5 && <2.6,
        guix-daemon-hs

test-suite scheduler-properties
    import: warnings
    type: exitcode-stdio-1.0
    hs-source-dirs: test/scheduler
    main-is: Main.hs
    build-depends:
        base,
        bytestring,
        containers,
        guix-daemon-hs

test-suite format-properties
    import: warnings
    type: exitcode-stdio-1.0
    hs-source-dirs: test/properties
    main-is: Main.hs
    build-depends:
        base,
        bytestring,
        containers,
        unix,
        guix-daemon-hs

test-suite format-vectors
    import: warnings
    type: exitcode-stdio-1.0
    hs-source-dirs: test/formats
    main-is: Main.hs
    build-depends:
        base,
        bytestring,
        containers,
        directory,
        guix-daemon-hs

test-suite wire-proxy
    import: warnings
    type: exitcode-stdio-1.0
    hs-source-dirs: test/wire-proxy
    main-is: Main.hs
    ghc-options: -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base,
        bytestring,
        containers,
        directory,
        filepath,
        process,
        network,
        unix,
        guix-daemon-hs

executable goonix-readonly-probe
    import: warnings
    hs-source-dirs: test/readonly
    main-is: RawClient.hs
    ghc-options: -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base,
        bytestring,
        network,
        guix-daemon-hs

executable goonix-activation-probe
    import: warnings
    hs-source-dirs: test/readonly
    main-is: Activate.hs
    ghc-options: -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base,
        network,
        unix,
        directory,
        guix-daemon-hs

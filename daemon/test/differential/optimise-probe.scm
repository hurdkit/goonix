(use-modules (guix store) (guix serialization) (ice-9 textual-ports))

(define (assert condition message)
  (unless condition (error message)))

(with-store store
  (let* ((fixture (getenv "HS7_FIXTURE"))
         (input (string-append fixture "/optimise-input"))
         (executable (string-append fixture "/optimise-executable"))
         (text (make-string 16384 #\x)))
    (mkdir input)
    (call-with-output-file (string-append input "/payload")
      (lambda (port) (display text port)))
    (call-with-output-file executable
      (lambda (port) (display text port)))
    (chmod executable #o755)
    (let* ((plain (add-to-store store "hs7-optimise-plain" #t "sha256" input))
           (duplicate (add-to-store store "hs7-optimise-duplicate" #t "sha256" input))
           (executable-path (add-to-store store "hs7-optimise-executable" #t "sha256" executable))
           (plain-file (string-append plain "/payload"))
           (duplicate-file (string-append duplicate "/payload")))
      (assert (= (stat:ino (stat plain-file)) (stat:ino (stat duplicate-file)))
              "registration did not deduplicate duplicate inputs")
      (assert (not (= (stat:ino (stat plain-file)) (stat:ino (stat executable-path))))
              "executable and non-executable files were incorrectly linked")
      (optimize-store store)
      (assert (verify-store store #:check-contents? #t)
              "optimised contents failed verification")
      (format #t "HS-7 optimisation: PASS\n"))))

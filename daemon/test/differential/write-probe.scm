(use-modules (guix store) (guix serialization) (srfi srfi-1) (ice-9 textual-ports))
(let* ((s (open-connection))
       (root (getenv "HS3_ROOT"))
       (a (add-text-to-store s "a.txt" "alpha\n" '()))
       (b (add-text-to-store s "b.txt" "beta references\n" (list a)))
       (n (add-to-store s "tree" #t "sha256"
                        (string-append root "/input-tree")))
       (flat (add-to-store s "flat.txt" #f "sha256"
                           (string-append root "/flat.txt"))))
  (format #t "a=~a\nb=~a\nn=~a\nflat=~a\n" a b n flat)
  (format #t "valid=~s/~s/~s/~s\n" (valid-path? s a) (valid-path? s b) (valid-path? s n) (valid-path? s flat))
  (format #t "flat-contents=~s\n" (call-with-input-file flat get-string-all))
  (format #t "info-a=~s\n" (query-path-info s a))
  (format #t "refs-b=~s\n" (references s b))
  (format #t "store-mode=~o\n" (stat:perms (stat (%store-prefix))))
  (unless (= (logand (stat:perms (stat (%store-prefix))) #o200) #o200)
    (error "deduplication made the store directory unwritable"))
  (format #t "roots=~s\n" (find-roots s))
  (add-temp-root s a)
  (let ((link (string-append root "/root-link")))
    (call-with-output-file link (lambda (p) (display a p)))
    (add-indirect-root s link))
  (format #t "roots-after=~s\n" (find-roots s))
  (close-connection s))

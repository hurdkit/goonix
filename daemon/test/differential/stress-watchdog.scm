;;; goonix stress gate: the watchdog.  A cheap query every second, recording each
;;; latency, until a stop-file appears.  Args: SOCKET STOP-FILE BOUND
(use-modules (guix store) (guix utils) (guix tests) (gnu packages bootstrap)
             (ice-9 match) (srfi srfi-19))
(define socket (cadr (command-line)))
(define stop-file (caddr (command-line)))
(define bound (string->number (cadddr (command-line))))
(define (now) (current-time))
(define (elapsed-since start)
  (let ((d (time-difference (now) start)))
    (+ (time-second d) (/ (time-nanosecond d) 1e9))))
(define s0 (open-connection socket))
(define bash (add-to-store s0 "bash" #t "sha256"
                           (search-bootstrap-binary "bash" (%current-system))))
(close-connection s0)
(define max-lat 0)
(define count 0)
(define fail #f)
(let loop ()
  (unless (file-exists? stop-file)
    (let ((start (now)))
      (catch #t
        (lambda ()
          (let ((s (open-connection socket)))
            (valid-path? s bash)
            (close-connection s)))
        (lambda (key . args)
          (format #t "watchdog: query error ~a ~a~%" key args)))
      (let ((lat (elapsed-since start)))
        (set! count (+ count 1))
        (when (> lat max-lat) (set! max-lat lat))
        (when (> lat bound)
          (set! fail #t)
          (format #t "watchdog: query ~a took ~,3fs > bound ~,3fs~%" count lat bound)))
      (usleep 1000000)
      (loop))))
(format #t "watchdog: ~a queries, max latency ~,3fs (bound ~,3fs)~%" count max-lat bound)
(if (and (not fail) (> count 0) (<= max-lat bound))
    (begin (format #t "watchdog: PASS~%") (primitive-exit 0))
    (begin (format #t "watchdog: FAIL~%") (primitive-exit 1)))
;; Compute every input output in the reachable derivation graph without
;; building anything. Only the selected package outputs are excluded.
(use-modules (guix) (guix store) (guix packages) (guix derivations)
             (gnu packages base) (gnu packages compression)
             (srfi srfi-1) (srfi srfi-26) (ice-9 hash-table))
(%graft? #f)
(define store (open-connection (getenv "GUIX_DAEMON_SOCKET")))
(set-build-options store #:use-substitutes? #f #:substitute-urls '())
(define packages (list hello bzip2 sed))
(define derivations (map (lambda (package) (package-derivation store package)) packages))
(define selected (map derivation->output-path derivations))
(define seen (make-hash-table))
(define (visit-input input port)
  (let* ((drv (derivation-input-derivation input))
         (key (cons (derivation-file-name drv)
                    (derivation-input-sub-derivations input))))
    (unless (hash-ref seen key)
      (hash-set! seen key #t)
      (for-each (lambda (name)
                  (let ((path (derivation->output-path drv name)))
                    (unless (member path selected)
                      (format port "~a~%" path))))
                (derivation-input-sub-derivations input))
      (for-each (lambda (dependency) (visit-input dependency port))
                (derivation-inputs drv)))))
(call-with-output-file (getenv "HS6_INPUT_PATHS")
  (lambda (port)
    (for-each
     (lambda (package drv)
       (for-each (lambda (input) (visit-input input port)) (derivation-inputs drv))
       (format #t "package=~a version=~a derivation=~a output=~a~%"
               (package-name package) (package-version package)
               (derivation-file-name drv) (derivation->output-path drv)))
     packages derivations)))
(close-connection store)

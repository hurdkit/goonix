;;; goonix stress gate: the garbage-collection client.  Args: SOCKET ROUNDS
(use-modules (guix store) (ice-9 match))
(define socket (cadr (command-line)))
(define rounds (string->number (caddr (command-line))))
(define s (open-connection socket))
(set-build-options s #:use-substitutes? #f #:offload? #f)
(let loop ((i 0))
  (when (< i rounds)
    (collect-garbage s)
    (usleep 300000)
    (loop (+ i 1))))
(close-connection s)
(format #t "gc: PASS (~a rounds)~%" rounds)
(primitive-exit 0)
(use-modules (guix store) (srfi srfi-11) (ice-9 rdelim) (ice-9 textual-ports))

(define (assert condition message)
  (unless condition (error message)))

(define fixture (getenv "HS7_FIXTURE"))
(define store (open-connection (getenv "HS7_COLLECTOR_SOCKET")))
(set-build-options store #:use-substitutes? #f #:offload? #f)
(define drv (call-with-input-file (string-append fixture "/builder-drv") read-line))
(define input (call-with-input-file (string-append fixture "/builder-input") read-line))
(define output (call-with-input-file (string-append fixture "/builder-output") read-line))
(define work (call-with-input-file (string-append fixture "/builder-work") read-line))
(define input-output (call-with-input-file (string-append fixture "/input-output") read-line))
(assert (valid-path? store input-output)
        "closed input connection did not leave its built output")
(assert (not (file-exists? (string-append fixture "/builder-finished")))
        "builder finished before collection began")
(assert (valid-path? store drv) "builder's derivation was deleted")
(assert (file-exists? drv) "builder's derivation file was deleted")
(assert (valid-path? store input) "builder's input was invalidated")
(assert (file-exists? input) "builder's input file was deleted")
(assert (file-exists? work) "builder's working directory was deleted")
(assert (not (valid-path? store output)) "builder's output was registered prematurely")
(let ((dead (call-with-input-file (string-append fixture "/dead-path") read-line)))
  (assert (valid-path? store dead) "dead path fixture is missing")
  (let-values (((deleted freed) (collect-garbage store)))
    (call-with-output-file (string-append fixture "/deleted-paths")
      (lambda (port) (for-each (lambda (path) (display path port) (newline port)) deleted)))
    (call-with-output-file (string-append fixture "/collector-finished")
      (lambda (port) (display "done" port) (newline port)))
    (assert (member dead deleted) "collection did not delete the dead path")
    (assert (not (member drv deleted)) "collector deleted the running derivation")
    (assert (not (member input deleted)) "collector deleted a running builder input")
    (assert (not (member input-output deleted))
            "collector deleted an input derivation's output")))
(assert (not (file-exists? (string-append fixture "/builder-finished")))
        "builder finished before collection returned")
(assert (valid-path? store drv) "running derivation became invalid")
(assert (valid-path? store input) "running input became invalid")
(assert (valid-path? store input-output)
        "input derivation output became invalid during its dependent's build")
(assert (file-exists? input-output)
        "input derivation output disappeared during its dependent's build")
(call-with-output-file (string-append fixture "/input-output-after-gc")
  (lambda (port)
    (display (call-with-input-file input-output get-string-all) port)))
(assert (file-exists? work) "work directory disappeared during collection")
(assert (not (file-exists? output)) "output was constructed during collection")
(close-connection store)

;;; goonix stress gate: the roots client (indirect roots + temporary roots).
;;; Args: SOCKET ROUNDS
(use-modules (guix store) (guix derivations) (guix utils) (guix tests)
             (gnu packages bootstrap) (ice-9 match))
(define socket (cadr (command-line)))
(define rounds (string->number (caddr (command-line))))
(define s (open-connection socket))
(set-build-options s #:use-substitutes? #f #:offload? #f)
(define bash (add-to-store s "bash" #t "sha256"
                           (search-bootstrap-binary "bash" (%current-system))))
(define drv (derivation s "stress-rooted" bash '("-c" "echo rooted > $out")
                        #:sources (list bash)))
(define out (derivation->output-path drv))
(build-derivations s (list drv))
(let loop ((i 0))
  (when (< i rounds)
    (add-indirect-root s out)
    (add-temp-root s out)
    (usleep 300000)
    (loop (+ i 1))))
(close-connection s)
(if (valid-path? (open-connection socket) out)
    (begin (format #t "roots: PASS ~a~%" out) (primitive-exit 0))
    (begin (format #t "roots: FAIL~%") (primitive-exit 1)))
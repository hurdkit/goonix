;; Build the same derivations after the first client has gone away.
(use-modules (guix store) (guix derivations) (guix tests)
             (ice-9 rdelim) (srfi srfi-34))
(define (report-failure condition)
  (format (current-error-port) "engine-disconnect retry failed: ~s~%" condition)
  (force-output (current-error-port))
  (raise condition))
(guard (condition (else (report-failure condition)))
(define fixture (getenv "HS4_SCHEDULER_FIXTURE"))
(define store (open-connection (getenv "GUIX_DAEMON_SOCKET")))
(set-build-options store #:use-substitutes? #f #:offload? #f #:max-build-jobs 2)
(define (read-path name)
  (call-with-input-file (string-append fixture "/" name ".drv") read-line))
(define paths (map read-path '("disconnect-left" "disconnect-right")))
(build-derivations store paths)
(for-each (lambda (name)
            (let ((output (call-with-input-file
                            (string-append fixture "/" name ".output") read-line)))
              (unless (valid-path? store output)
                (error "retry did not register output" name))))
          '("disconnect-left" "disconnect-right"))
(close-connection store))

;; A completed build must not be cancelled while its reply is being consumed.
(use-modules (guix store) (guix derivations) (guix tests)
             (gnu packages bootstrap) (ice-9 rdelim) (srfi srfi-34))
(define (report-failure condition)
  (format (current-error-port) "engine-disconnect completed client failed: ~s~%" condition)
  (force-output (current-error-port))
  (raise condition))
(guard (condition (else (report-failure condition)))
(define fixture (getenv "HS4_SCHEDULER_FIXTURE"))
(define store (open-connection (getenv "GUIX_DAEMON_SOCKET")))
(set-build-options store #:use-substitutes? #f #:offload? #f)
(%graft? #f)
(define shell (add-to-store store "bash" #t "sha256"
               (search-bootstrap-binary "bash" "x86_64-linux")))
(define body (add-text-to-store store "completed-before-close.sh"
  (string-append "printf '%s\\n' $$ > '" fixture "/completed-builder.pid'\n"
                 "printf finished > $out\n")))
(define drv (derivation store "completed-before-close" shell (list "-e" body)
                        #:sources (list shell body)))
(build-derivations store (list drv))
(unless (valid-path? store (derivation->output-path drv))
  (error "completed output was not registered"))
(call-with-output-file (string-append fixture "/completed-output")
  (lambda (port) (display (derivation->output-path drv) port) (newline port)))
(call-with-output-file (string-append fixture "/completed-client-finished")
  (lambda (port) (display "done" port) (newline port)))
(close-connection store))

;; Deterministic helper used only for byte-for-byte daemon dialogue captures.
(use-modules (ice-9 match) (ice-9 rdelim) (ice-9 binary-ports)
             ((rnrs io ports) #:select (get-bytevector-n put-bytevector)))

(define (send-line port line)
  (display line port)
  (newline port)
  (force-output port))

(define (hex-string text)
  (string-append (number->string (string-length text)) ":" text))

(match (command-line)
  ((_ "substitute" "--query")
   (let loop ()
     (let ((line (read-line)))
       (unless (eof-object? line)
         (let ((fd4 (fdopen 4 "wl")))
           (cond
             ((string-prefix? "have " line)
              (send-line fd4 (cadr (string-split line #\space)))
              (send-line fd4 ""))
             ((string-prefix? "info " line)
              (send-line fd4 (cadr (string-split line #\space)))
              (send-line fd4 "")
              (send-line fd4 "0")
              (send-line fd4 "1234")
              (send-line fd4 "5678")
              (send-line fd4 ""))
             (else (send-line (current-error-port) "unknown query\n")))
           (close-port fd4))
         (loop)))))
  ((_ "substitute" "--substitute")
   (let ((line (read-line)))
     (unless (eof-object? line)
       (send-line (fdopen 4 "wl") "success sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef 42"))))
  ((_ "offload" system silent trace timeout)
   (let ((line (read-line)))
     (unless (eof-object? line)
       (send-line (current-output-port) "# accept")
       (let ((inputs (read-line)) (outputs (read-line)))
         (send-line (fdopen 4 "wl") "recorded remote output\n")
         (exit 0)))))
  (_ (exit 64)))

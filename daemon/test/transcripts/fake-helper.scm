(use-modules (ice-9 match) ((ice-9 rdelim) #:prefix rdelim:)
             ((guix build utils) #:select (dump-port))
             (guix serialization) (guix nar) (guix pki) (guix base16)
             (gcrypt hash) (gcrypt pk-crypto)
             ((rnrs io ports) #:select (get-string-all)))
(define read-line rdelim:read-line)
(define (line port text) (display text port) (newline port) (force-output port))
(define (register-output drv output)
  (let ((root (getenv "HS5_ROOT"))
        (source (string-append (getenv "HS5_ROOT") "/source")))
    (call-with-output-file source (lambda (p) (display "helper output\n" p)))
    (call-with-output-file (string-append root "/prefix")
      (lambda (port)
        (write-file source port)
        (write-value long-long #x4558494e port)
        (write-value store-path output port)
        (write-value string-list '() port)
        (write-value store-path drv port)))
    (let* ((hash (file-sha256 (string-append root "/prefix")))
           (key (string-append (getenv "GUIX_CONFIGURATION_DIRECTORY") "/signing-key"))
           (read-key (lambda (extension)
                       (call-with-input-file (string-append key extension)
                         (compose string->canonical-sexp get-string-all))))
           (public (read-key ".pub")) (secret (read-key ".sec"))
           (signature (canonical-sexp->string
                        (signature-sexp (bytevector->hash-data hash
                                          #:key-type (key-type public))
                                        secret public))))
      (call-with-output-file (string-append root "/bundle")
        (lambda (port)
          (write-value long-long 1 port)
          (call-with-input-file (string-append root "/prefix")
            (lambda (input) (dump-port input port)))
          (write-value long-long 1 port)
          (write-value utf8-string signature port)
          (write-value long-long 0 port)))
      (call-with-input-file (string-append root "/bundle")
        (lambda (port) (restore-file-set port #:lock? #f))))))

(match (command-line)
  ((program "offload" system silent trace timeout)
   (let ((line (read-line)))
     (unless (eof-object? line)
       (line (current-output-port) "# accept")
       (let* ((inputs (read-line)) (outputs (read-line))
              (drv (cadr (string-split line #\space)))
              (out (car (string-tokenize outputs))))
         (line (fdopen 4 "wl") "offload log\n")
         (register-output drv out)
         (exit 0)))))
  ((program "substitute" "--query")
   (let loop ()
     (let ((line (read-line)))
       (unless (eof-object? line)
         (let ((reply (fdopen 4 "wl")))
           (cond ((string-prefix? "have " line)
                  (line reply (cadr (string-split line #\space)))
                  (line reply ""))
                 ((string-prefix? "info " line)
                  (line reply (cadr (string-split line #\space)))
                  (line reply "") (line reply "0")
                  (line reply "12") (line reply "34") (line reply "")))
           (close-port reply))
         (loop)))))
  ((program "substitute" "--substitute")
   (let ((line (read-line)))
     (unless (eof-object? line)
       (line (fdopen 4 "wl") "substitute failed\n"))))
  ((program "discover")
   (exit 0))
  (_ (exit 64)))

(use-modules (guix nar) (guix pki) (guix base16) (gcrypt hash) (gcrypt pk-crypto)
             (guix serialization)
             ((guix build utils) #:select (dump-port))
             ((ice-9 rdelim) #:prefix rdelim:)
             ((rnrs io ports) #:select (get-string-all))
             (ice-9 match))

(define read-line rdelim:read-line)

(define (sign-with-key public-key secret-key sha256)
  (signature-sexp (bytevector->hash-data sha256
                    #:key-type (key-type public-key))
                  secret-key public-key))

;; Recording probe helper.  The HS-5 gate remains Guix's own test suite.
(match (command-line)
  ((program "offload" system silent trace timeout)
   (let ((log (open-file (string-append (getenv "HS5_ROOT") "/helper.log") "al")))
     (format log "args ~s ~s ~s ~s\n" system silent trace timeout)
     (force-output log)
     (let loop ((replies (string-tokenize (or (getenv "HS5_REPLIES") ""))))
       (let ((line (read-line)))
         (unless (eof-object? line)
           (format log "request ~a\n" line)
           (force-output log)
           (match (string-split line #\space)
             ((_ _ drv _)
              (let ((reply (if (null? replies)
                               (getenv "HS5_REPLY")
                               (car replies))))
                (when (getenv "HS5_DIAGNOSTIC")
                  (format #t "helper diagnostic\n"))
                (format #t "# ~a\n" reply)
                (force-output (current-output-port))
                (when (string=? reply "accept")
                  (let ((inputs (read-line)) (outputs (read-line)))
                    (format log "inputs ~a\noutputs ~a\n" inputs outputs)
                    (force-output log)
                    (when (getenv "HS5_BUILDER_OUTPUT")
                      (let ((builder-output (fdopen 4 "w")))
                        (display "offloaded builder output\n" builder-output)
                        (force-output builder-output)))
                    (case (string->symbol (or (getenv "HS5_RESULT") "success"))
                      ((success)
                       (let ((out (car (string-tokenize outputs)))
                             (temp (string-append (getenv "HS5_ROOT") "/output")))
                         (call-with-output-file temp
                           (lambda (p) (display "produced by helper\n" p)))
                         (call-with-output-file (string-append (getenv "HS5_ROOT") "/prefix")
                           (lambda (bundle)
                             (write-file temp bundle)
                             (write-value long-long #x4558494e bundle)
                             (write-value store-path out bundle)
                             (write-value string-list '() bundle)
                             (write-value store-path drv bundle)))
                         (let* ((digest (file-sha256 (string-append (getenv "HS5_ROOT") "/prefix")))
                                (key-dir (string-append (getenv "GUIX_CONFIGURATION_DIRECTORY") "/signing-key"))
                                (public (call-with-input-file (string-append key-dir ".pub")
                                          (compose string->canonical-sexp get-string-all)))
                                (secret (call-with-input-file (string-append key-dir ".sec")
                                          (compose string->canonical-sexp get-string-all)))
                                (signature (canonical-sexp->string (sign-with-key public secret digest))))
                           (call-with-output-file (string-append (getenv "HS5_ROOT") "/bundle")
                             (lambda (bundle)
                               (write-value long-long 1 bundle)
                               (call-with-input-file (string-append (getenv "HS5_ROOT") "/prefix")
                                 (lambda (prefix) (dump-port prefix bundle)))
                               (write-value long-long 1 bundle)
                               (write-value utf8-string signature bundle)
                               (write-value long-long 0 bundle))))
                         (call-with-input-file (string-append (getenv "HS5_ROOT") "/bundle")
                           (lambda (bundle)
                             (restore-file-set bundle #:lock? #f)))
                         (format log "registered ~a\n" out)
                         (force-output log)
                         (exit 0)))
                      ((unregistered) (exit 0))
                      ((exit17) (exit 17))
                      ((exit100) (exit 100))
                      ((signal) (kill (getpid) SIGTERM))
                      (else (exit 1)))))
                (loop (if (null? replies) replies (cdr replies)))))
             (_ (exit 1))))))))
  (_ (exit 64)))

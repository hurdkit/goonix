;; A second connection requests the output after the first builder owns it.
(use-modules (guix store) (guix derivations) (ice-9 rdelim) (srfi srfi-34))
(define (report-failure condition)
  (format (current-error-port) "disconnect waiter failed: ~s~%" condition)
  (force-output (current-error-port))
  (raise condition))
(guard (condition (else (report-failure condition)))
(define fixture (getenv "HS4_SCHEDULER_FIXTURE"))
(define store (open-connection (getenv "GUIX_DAEMON_SOCKET")))
(set-build-options store #:use-substitutes? #f #:offload? #f)
(define drv (call-with-input-file (string-append fixture "/shared-drv") read-line))
(call-with-output-file (string-append fixture "/waiter-started")
  (lambda (port) (display "waiting" port) (newline port)))
(build-derivations store (list drv))
(define output (call-with-input-file (string-append fixture "/shared-output") read-line))
(unless (valid-path? store output) (error "waiter did not obtain shared output"))
(call-with-output-file (string-append fixture "/waiter-finished")
  (lambda (port) (display "done" port) (newline port)))
(close-connection store))

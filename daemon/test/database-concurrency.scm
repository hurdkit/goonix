;; Simultaneous registration and prepared queries against distinct store paths.
(use-modules (guix store) (ice-9 threads) (ice-9 textual-ports)
             (srfi srfi-1) (srfi srfi-34))

(define (check condition label value)
  (unless condition (error label value)))
(define socket (getenv "GUIX_DAEMON_SOCKET"))
(define clients 4)
(define iterations 20)
(define lock (make-mutex))
(define ready 0)
(define failures '())
(define completed 0)
(define (record-failure condition)
  (with-mutex lock
    (set! failures (cons condition failures))
    (format (current-error-port) "database worker: ~s~%" condition)
    (force-output (current-error-port))))
(define (worker thunk)
  (guard (condition (#t (record-failure condition))) (thunk)))
(define (await-start)
  ;; A failed peer must not leave other clients asleep on a condition variable.
  (with-mutex lock (set! ready (+ ready 1)))
  (let loop ((remaining 10000))
    (cond ((= ready clients) #t)
          ((zero? remaining) (error "database clients did not reach startup"))
          (else (usleep 1000) (loop (- remaining 1))))))
(define (name client iteration)
  (string-append "hs6-db-direct-" (number->string client) "-" (number->string iteration)))
(define (verify store path text)
  (check (valid-path? store path) "registered path missing" path)
  (let ((info (query-path-info store path)))
    (check (path-info? info) "path-info answer is invalid" path)
    (check (null? (path-info-references info)) "wrong references" path)
    (check (not (path-info-deriver info)) "wrong deriver" path)
    (check (> (path-info-nar-size info) 0) "wrong nar size" path))
  (check (equal? text (call-with-input-file path get-string-all))
         "wrong path content" path))
(define (exercise client)
  (let ((store (open-connection socket)))
    (let ((initial (add-text-to-store store (name client 0) "initial")))
      (verify store initial "initial"))
    (await-start)
    (for-each
     (lambda (iteration)
       (let* ((item-name (name client (+ iteration 1)))
              (text (string-append "contents-" item-name))
              (path (add-text-to-store store item-name text)))
         (verify store path text)
         (verify store path text)
         (with-mutex lock (set! completed (+ completed 1)))))
     (iota iterations))
    (close-connection store)))
(define threads
  (map (lambda (client) (call-with-new-thread (lambda () (worker (lambda () (exercise client))))))
       (iota clients)))
(for-each join-thread threads)
(unless (null? failures) (raise-exception (car failures)))
(check (= (* clients iterations) completed) "missing completed registrations" completed)
(format #t "HS-6 direct concurrent registrations and queries: PASS (~a paths)~%" completed)

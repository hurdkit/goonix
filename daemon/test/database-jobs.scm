;; Same-client prepared statements used by simultaneous engine jobs.
(use-modules (guix store) (guix derivations) (guix tests)
             (gnu packages bootstrap) (ice-9 threads) (ice-9 textual-ports)
             (srfi srfi-1) (srfi srfi-34))
(define (check condition label value)
  (unless condition (error label value)))
(define socket (getenv "GUIX_DAEMON_SOCKET"))
(define store (open-connection socket))
(set-build-options store #:use-substitutes? #f #:offload? #f #:max-build-jobs 8)
(%graft? #f)
(define shell (add-to-store store "bash" #t "sha256"
               (search-bootstrap-binary "bash" "x86_64-linux")))
(define sleep shell)
(define (range start count)
  (if (zero? count) '() (cons start (range (+ start 1) (- count 1)))))
(define count 64)
(define paths
  (map (lambda (index)
         (let* ((name (string-append "hs6-db-ref-" (number->string index)))
                (path (add-text-to-store store name name)))
           (let ((info (query-path-info store path)))
             (check (path-info? info) "initial path-info failed" path)
             (check (null? (path-info-references info)) "initial references wrong" path))
           path))
       (iota count)))
(define (graph index)
  (apply string-append
         (map (lambda (other)
                (string-append "ref" (number->string other) " "
                               (list-ref paths other) " "))
              (iota count))))
(define (make-drv index)
  (let* ((name (string-append "hs6-db-builder-" (number->string index)))
         (body (add-text-to-store store (string-append name ".sh")
                 (string-append
                  "i=0; while test $i -lt 200; do i=$((i+1)); read -t 0.01 _ || :; done\n"
                  "printf '%s\\n' '" name "' > $out\n"))))
    (derivation store name shell (list "-e" body)
                #:sources (list shell body)
                #:env-vars `(("exportReferencesGraph" . ,(graph index))))))
(define graphers (map make-drv (range 1 20)))
(define all graphers)
(check (= 20 (length all)) "wrong reference-graph job count" all)
(build-derivations store all)
(for-each
 (lambda (drv)
   (let ((info (query-path-info store (derivation->output-path drv))))
     (check (equal? (path-info-deriver info) (derivation-file-name drv))
            "registered output has wrong deriver" drv)
     (check (null? (path-info-references info)) "registered output has wrong refs" drv)))
 all)
(close-connection store)
(format #t "HS-6 same-client concurrent reference-graph queries: PASS (~a outputs)~%"
        (length all))

;;;
;;; Produce Haskell string literals with Scheme's byte-preserving escapes.
;;; Keeping this tiny generator in the existing build avoids an extra parser
;;; for Cabal files or for the SQL schema.

(use-modules (ice-9 match) (rnrs io ports))

(define (write-literal text)
  (write text (current-output-port)))

(match (command-line)
  ((_ output store state log config bin locale system substitutes schema)
   (call-with-output-file output
     (lambda (port)
       (set-current-output-port port)
       (display "{-# LANGUAGE GHC2024 #-}\n")
       (display "-- Generated by make-config.scm; do not edit.\n")
       (display "module Goonix.Config where\n\n")
       (for-each
        (lambda (name value)
          (format #t "~a :: String\n~a = " name name)
          (write-literal value)
          (newline))
        (list "storeDirectory" "stateDirectory" "logDirectory"
              "configurationDirectory" "binaryDirectory" "localeDirectory"
              "systemType" "defaultSubstituteUrls" "schemaSql")
        (append (list store state log config bin locale system substitutes)
                (list (call-with-input-file schema get-string-all)))))))
  (_ (error "invalid generated-config arguments")))

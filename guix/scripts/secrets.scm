;;; goonix: the 'guix secrets' command.
(define-module (guix scripts secrets)
  #:use-module (guix secrets age)
  #:use-module (guix secrets vault)
  #:use-module (guix scripts)
  #:use-module (guix ui)
  #:use-module (guix diagnostics)
  #:use-module (guix i18n)
  #:use-module (guix build utils)
  #:use-module ((guix utils) #:select (with-atomic-file-output))
  #:use-module (ice-9 match)
  #:use-module (ice-9 textual-ports)
  #:use-module (ice-9 binary-ports)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-37)
  #:use-module (srfi srfi-11)
  #:use-module (gcrypt random)
  #:use-module ((gcrypt base16) #:select (base16-string->bytevector))
  #:use-module (rnrs bytevectors)
  #:use-module (ice-9 format)
  #:export (guix-secrets))

(define (show-help)
  (display (G_ "Usage: guix secrets COMMAND [OPTION...] [ARGUMENT]...
Manage an age-encrypted project or local vault.
Commands: init, add, edit, show, decrypt, generate, list, check, rekey, exec.
  -l, --local             use the local vault
  -d, --directory=DIR     project or vault directory
  -i, --identity=FILE     read this identity, never copy it
  -o, --output=FILE       write plaintext outside the project
  -h, --help              display this help and exit\n")))

(define %options
  (list (option '(#\l "local") #f #f (lambda (o n a r) (alist-cons 'local #t r)))
        (option '(#\d "directory") #t #f (lambda (o n a r) (alist-cons 'directory a r)))
        (option '(#\i "identity") #t #f (lambda (o n a r) (alist-cons 'identity a r)))
        (option '(#\o "output") #t #f (lambda (o n a r) (alist-cons 'output a r)))
        (option '(#\h "help") #f #f (lambda args (show-help) (exit 0)))
        (option '(#\V "version") #f #f
                (lambda args (show-version-and-exit "guix secrets")))))

(define (vault-file directory) (string-append directory "/vault.scm"))
(define (load-vault directory) (call-with-input-file (vault-file directory) read-vault))
(define (identity opts) (read-identity (or (assoc-ref opts 'identity) (identity-file))))
(define (vault-path opts)
  (or (assoc-ref opts 'directory) (vault-directory (assoc-ref opts 'local))))
(define (ensure-parent file) (mkdir-p (dirname file)))
(define (print-secret bytes) (put-bytevector (current-output-port) bytes))
(define (write-vault-file directory vault)
  (ensure-parent (vault-file directory))
  (with-atomic-file-output (vault-file directory)
    (lambda (p)
      (write `(vault (format 1)
                     (recipients ,@(map (lambda (r) (list (car r) (cdr r)))
                                        (vault-recipients vault)))
                     (secrets ,@(map (lambda (s)
                                       `(,(secret-name s) (kind ,(secret-kind s))
                                         (for ,@(secret-recipients s))
                                         (owner ,(secret-owner s))
                                         ,@(if (secret-group s)
                                               `((group ,(secret-group s))) '())
                                         (mode ,(secret-mode s))))
                                     (vault-secrets vault)))) p)
      (newline p))))
(define (generate-password)
  (let ((alphabet "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"))
    (let loop ((chars '()))
      (if (= 32 (length chars)) (list->string (reverse chars))
          (let ((n (bytevector-u8-ref (gen-random-bv 1) 0)))
            (if (< n 248)
                (loop (cons (string-ref alphabet (modulo n 62)) chars))
                (loop chars)))))))
(define (one-argument arguments command)
  (unless (= 1 (length arguments)) (error "command requires one name" command))
  (string->symbol (car arguments)))
(define (path-inside? directory file)
  (let ((prefix (string-append (canonicalize-path directory) "/")))
    (or (string-prefix? prefix file) (string-prefix? "/gnu/store/" file)
        (string-prefix? (string-append (%store-directory) "/") file))))
(define (decrypt-output directory output)
  (unless output (error "decrypt requires --output=FILE"))
  (when (file-exists? output) (error "refusing to overwrite an existing output" output))
  (let ((parent (canonicalize-path (dirname output))))
    (when (path-inside? directory (string-append parent "/" (basename output)))
      (error "decrypt output must be outside the vault and store")))
  output)
(define (local-project-directory vault-directory)
  (let ((parent (dirname (canonicalize-path vault-directory))))
    (or (getenv "GUIX_SECRETS_LOCAL_OPTIONS_DIRECTORY") parent)))
(define (check-vault-name-collision)
  (let* ((shared (vault-directory #f))
         (local (vault-directory #t)))
    (when (and local (file-exists? (vault-file shared)) (file-exists? (vault-file local))
               (not (string=? (canonicalize-path shared) (canonicalize-path local))))
      (let ((shared-names (list-secrets (load-vault shared)))
            (local-names (list-secrets (load-vault local))))
        (for-each (lambda (name)
                    (when (memq name local-names)
                      (error "secret name occurs in both shared and local vaults" name)))
                  shared-names)))))

(define-command (guix-secrets . args)
  (category plumbing)
  (synopsis "manage age-encrypted secrets")
  (with-error-handling
   (let-values (((before after) (break (lambda (arg) (string=? "--" arg)) args)))
     (let* ((opts (parse-command-line before %options (list '()) #:build-options? #f
                                      #:argument-handler (lambda (a r) (alist-cons 'argument a r))))
            (arguments (reverse (filter-map (match-lambda (('argument . a) a) (_ #f)) opts)))
            (command (and (pair? arguments) (car arguments)))
            (rest (if command (cdr arguments) '()))
            (directory (vault-path opts)))
       (when (and (pair? after) (not (string=? "exec" command)))
         (error "-- is only valid for guix secrets exec"))
       (unless (string=? "init" command) (check-vault-name-collision))
       (match command
         ("init"
          (when (file-exists? (vault-file directory)) (error "vault already exists" directory))
          (let* ((id (generate-identity (or (assoc-ref opts 'identity) (identity-file))))
                 (recipient (cond ((string? id) (x25519-identity-public id))
                                  ((pair? id) (ssh-public-key-text (caddr id)))
                                  (else (error "unsupported identity"))))
                 (vault (make-vault `((owner . ,recipient)) '())))
            (mkdir-p directory) (chmod directory #o700)
            (write-vault-file directory vault)
            (format #t "~a~%" recipient)))
         ((or "add" "edit")
          (edit-secret directory (load-vault directory)
                       (one-argument rest command) (identity opts)
                       (or (getenv "VISUAL") (getenv "EDITOR") "nano")))
         ("show"
          (print-secret (show-secret directory (load-vault directory)
                                     (one-argument rest command) (identity opts))))
         ("decrypt"
          (let* ((name (one-argument rest command))
                 (output (decrypt-output directory (assoc-ref opts 'output))))
            (ensure-parent output)
            (call-with-output-file output
              (lambda (p) (chmod output #o600)
                      (put-bytevector p (show-secret directory (load-vault directory)
                                                    name (identity opts)))))))
         ("generate"
          (unless (= 2 (length rest)) (error "generate needs KIND and NAME"))
          (let ((kind (string->symbol (car rest))) (name (string->symbol (cadr rest)))
                (vault (load-vault directory)) (id (identity opts)))
            (case kind
              ((password)
               (let ((secret (find (lambda (s) (eq? name (secret-name s))) (vault-secrets vault))))
                 (unless (and secret (eq? 'password (secret-kind secret)))
                   (error "generate password needs a declared password secret" name))
                 (add-secret directory vault name kind (string->utf8 (generate-password)) id)))
              ((ssh-key) (generate-ssh-key directory vault name id))
              (else (error "unknown generated secret kind" kind)))
            (when (and (assoc-ref opts 'local) (eq? kind 'ssh-key))
              (write-local-option (local-project-directory directory)
                                  (symbol-append name '-public-key)
                                  (call-with-input-file
                                      (string-append directory "/" (symbol->string name) ".pub")
                                    get-string-all)))))
         ("list" (for-each (lambda (name) (format #t "~a~%" name))
                           (list-secrets (load-vault directory))))
         ("check" (check-vault directory (load-vault directory) (identity opts)
                               #:project-directory (getcwd)))
         ("rekey" (rekey-vault directory (load-vault directory) (identity opts)))
         ("exec"
          (let ((command (append rest (if (pair? after) (cdr after) '()))))
            (unless (pair? command) (error "exec needs a command after --"))
            (primitive-exit (exec-with-secrets directory (load-vault directory)
                                               (identity opts) command))))
         (_ (show-help) (exit 1)))))))

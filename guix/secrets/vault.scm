(define-record-type <secret>
  (make-secret name kind recipients owner group mode)
  secret?
  (name secret-name)
  (kind secret-kind)
  (recipients secret-recipients)
  (owner secret-owner)
  (group secret-group)
  (mode secret-mode))

(define-record-type <vault>
  (make-vault recipients secrets)
  vault?
  (recipients vault-recipients)
  (secrets vault-secrets))

(define valid-name? (@ (guix secrets declaration) valid-secret-name?))
(define (property properties name default)
  (match (assq name properties) ((_ value) value) (#f default)
         (_ (error "duplicate vault property" name))))
(define (property-list properties name)
  (match (assq name properties)
    ((_ values ...) values)
    (#f #f)
    (_ (error "duplicate vault property" name))))
(define (parse-secret datum recipients)
  (match datum
    ((name . properties)
     (unless (valid-name? name) (error "invalid secret name" name))
     (let ((property-names (filter-map (lambda (p) (and (pair? p) (car p))) properties)))
       (unless (= (length property-names) (length (delete-duplicates property-names)))
         (error "duplicate secret property" name)))
     (let* ((kind (property properties 'kind 'file))
            (for (property-list properties 'for))
            (owner (property properties 'owner "root"))
            (group (property properties 'group #f))
            (mode (property properties 'mode #o400)))
       (unless (memq kind '(file password ssh-key)) (error "unknown secret kind" kind))
       (unless (and (pair? for) (every (lambda (name) (assq name recipients)) for)
                    (= (length for) (length (delete-duplicates for))))
         (error "secret has an unknown or empty recipient list" name))
       (unless (and (string? owner) (or (not group) (string? group))
                    (integer? mode) (<= 0 mode #o777))
         (error "invalid secret materialisation properties" name))
       (for-each (lambda (p) (unless (memq (car p) '(kind for owner group mode))
                              (error "unknown secret property" p))) properties)
       (make-secret name kind for owner group mode)))))
(define (read-vault port)
  "Read exactly one data-only vault form. Never read an identity or decrypt."
  (let ((form (read-data-port port "vault.scm")))
    (match form
      (('vault . members)
       (unless (assq 'format members) (error "vault format is missing"))
       (unless (equal? (assq 'format members) '(format 1))
         (error "unsupported vault format"))
       (unless (= 1 (length (filter (lambda (x) (eq? (car x) 'format)) members)))
         (error "duplicate vault format"))
       (let ((member-names (filter-map (lambda (m) (and (pair? m) (car m))) members)))
         (unless (= (length member-names) (length (delete-duplicates member-names)))
           (error "duplicate vault member")))
       (let* ((recipients-form (assq 'recipients members))
              (secrets-form (assq 'secrets members))
              (recipients (if recipients-form (cdr recipients-form)
                              (error "vault recipients are missing")))
              (secrets-data (if secrets-form (cdr secrets-form)
                                (error "vault secrets are missing"))))
         (for-each (lambda (m) (unless (memq (car m) '(format recipients secrets))
                                (error "unknown vault member" m))) members)
         (unless (and (list? recipients) (list? secrets-data))
           (error "invalid vault lists"))
         (let ((recipient-alist
                (map (lambda (r)
                       (match r
                         ((name key)
                          (unless (and (valid-name? name) (string? key)
                                       (or (string-prefix? "age1" key)
                                           (string-prefix? "ssh-ed25519 " key)))
                            (error "invalid vault recipient" r))
                          (cons name key))
                         (_ (error "invalid recipient form" r)))) recipients)))
           (unless (= (length recipient-alist)
                      (length (delete-duplicates (map car recipient-alist))))
             (error "duplicate vault recipient"))
           (let ((secrets (map (cut parse-secret <> recipient-alist) secrets-data)))
             (unless (= (length secrets)
                        (length (delete-duplicates (map secret-name secrets))))
               (error "duplicate vault secret"))
             (make-vault recipient-alist secrets)))))
      (_ (error "expected a single vault form")))))

(define (default-identity)
  (or (getenv "GUIX_SECRETS_IDENTITY")
      (string-append (config-directory) "/secrets/identity.txt")))
(define (identity-file) (default-identity))
(define (vault-directory local?)
  (or (and local? (getenv "GUIX_SECRETS_LOCAL_VAULT"))
      (and (not local?) (getenv "GUIX_SECRETS_VAULT"))
      (if local?
          (string-append (or (getenv "XDG_STATE_HOME")
                             (string-append (getenv "HOME") "/.local/state"))
                         "/guix/secrets-local")
          (string-append (getcwd) "/secrets"))))
(define (read-identity file)
  (read-identity-with-passphrase file read-passphrase))
(define* (read-identity-with-passphrase file passphrase-provider)
  "Read native, SSH or age-scrypt identity material without copying it."
  (unless (file-exists? file) (error "age identity file does not exist" file))
  (let* ((bytes (call-with-input-file file get-bytevector-all))
         (text (bytevector->string bytes "ISO-8859-1")))
    (cond ((parse-x25519-identity text))
          ((string-contains text "-----BEGIN OPENSSH PRIVATE KEY-----")
           (read-ssh-identity file))
          ((or (string-prefix? "age-encryption.org/v1" text)
               (string-contains text "-----BEGIN AGE ENCRYPTED FILE-----"))
           (let ((passphrase (passphrase-provider file)))
             (read-identity-text
              (utf8->string (decrypt-scrypt text passphrase)))))
          (else (error "no supported identity in identity file" file)))))
(define (read-identity-text text)
  (or (parse-x25519-identity text)
      (and (string-contains text "-----BEGIN OPENSSH PRIVATE KEY-----")
           (read-ssh-identity-text text))
      (error "decrypted identity has no supported key")))
(define (termios-without-echo attributes)
  "Return ATTRIBUTES with terminal echo disabled.  Use the private constructor
rather than changing the syscall module shared with upstream package builds."
  ((@@ (guix build syscalls) termios) (termios-input-flags attributes)
           (termios-output-flags attributes)
           (termios-control-flags attributes)
           (logand (termios-local-flags attributes)
                   (lognot (local-flags ECHO)))
           (termios-line-discipline attributes)
           (termios-control-chars attributes)
           (termios-input-speed attributes)
           (termios-output-speed attributes)))
(define (read-passphrase-from-port port file)
  (let ((fd (fileno port))
        (attributes (tcgetattr (fileno port))))
    (dynamic-wind
      (lambda ()
        (tcsetattr fd (tcsetattr-action TCSANOW)
                   (termios-without-echo attributes)))
      (lambda ()
        (format port "Enter passphrase for identity file ~a: " file)
        (force-output port)
        (let ((passphrase (get-line port)))
          (newline port)
          (if (eof-object? passphrase)
              (error "end of file while reading identity passphrase")
              passphrase)))
      (lambda () (tcsetattr fd (tcsetattr-action TCSANOW) attributes)))))
(define (read-passphrase file)
  "Read a passphrase on /dev/tty with echo disabled, restoring its settings."
  (let ((port (false-if-exception (open-file "/dev/tty" "r+"))))
    (unless port (error "encrypted identity requires a terminal for its passphrase"))
    (dynamic-wind
      (const #t)
      (lambda () (read-passphrase-from-port port file))
      (lambda () (close-port port)))))
(define (write-private-file file text)
  (mkdir-p (dirname file))
  (with-atomic-file-output file
    (lambda (port) (chmod (port-filename port) #o600) (display text port))))
(define (generate-identity file)
  (if (file-exists? file) (read-identity file)
      (let ((identity (generate-x25519-identity)))
        (write-private-file file (string-append "# goonix local age identity\n" identity "\n"))
        identity)))
(define (ciphertext-path directory name) (string-append directory "/" (symbol->string name) ".age"))
(define (public-path directory name) (string-append directory "/" (symbol->string name) ".pub"))
(define (read-secret-file directory name)
  (call-with-input-file (ciphertext-path directory name) get-string-all))
(define (secret-key secret directory identity)
  (decrypt-age-file (read-secret-file directory (secret-name secret)) (list identity)))
(define (write-secret directory name plaintext recipients)
  (mkdir-p directory)
  (chmod directory #o700)
  (with-atomic-file-output (ciphertext-path directory name)
    (lambda (port) (chmod (port-filename port) #o600)
            (display (encrypt-age plaintext recipients) port))))
(define (generate-ssh-key directory vault name identity)
  "Generate in memory and encrypt before any private key reaches a file."
  (let ((secret (find (lambda (s) (eq? name (secret-name s))) (vault-secrets vault))))
    (unless (and secret (eq? 'ssh-key (secret-kind secret)))
      (error "generate ssh-key needs a declared ssh-key secret" name))
    (call-with-values generate-ssh-key-pair
      (lambda (private public)
        (add-secret directory vault name 'ssh-key (string->utf8 private) identity)
        (with-atomic-file-output (public-path directory name)
          (lambda (port) (display public port)))))))
(define (add-secret directory vault name kind plaintext identity)
  (let ((recipients (map (lambda (r) (or (assq-ref (vault-recipients vault) r)
                                         (error "unknown recipient" r)))
                         (or (and=> (find (lambda (s) (eq? (secret-name s) name))
                                          (vault-secrets vault)) secret-recipients)
                             (map car (vault-recipients vault))))))
    (unless (pair? recipients) (error "a secret needs at least one recipient"))
    (write-secret directory name plaintext recipients)))
(define (plaintext-parent-directory)
  "Prefer volatile storage; GUIX_SECRETS_TEST_TMPDIR is for the test only."
  (let ((override (getenv "GUIX_SECRETS_TEST_TMPDIR"))
        (runtime (getenv "XDG_RUNTIME_DIR")))
    (cond (override override)
          ((and runtime (file-is-directory? runtime)) runtime)
          ((file-is-directory? "/dev/shm") "/dev/shm")
          (else
           (let ((fallback (or (getenv "TMPDIR") "/tmp")))
             (format (current-error-port)
                     "guix secrets: warning: plaintext temporary files are on ~a; ~
                      use XDG_RUNTIME_DIR or /dev/shm for tmpfs~%" fallback)
             fallback)))))
(define (private-temporary-directory suffix)
  (let ((directory (mkdtemp! (string-append (plaintext-parent-directory)
                                           "/guix-secrets" suffix ".XXXXXX"))))
    (chmod directory #o700)
    directory))
(define (edit-secret directory vault name identity editor)
  "Edit plaintext only in a private directory; encrypt after EDITOR succeeds."
  (let* ((secret (find (lambda (s) (eq? name (secret-name s))) (vault-secrets vault)))
         (tmp (private-temporary-directory "-edit")))
    (unless secret (delete-file-recursively tmp)
            (error "declare the secret in vault.scm first" name))
    (chmod tmp #o700)
    (dynamic-wind
      (const #t)
      (lambda ()
        (let ((file (string-append tmp "/" (symbol->string name))))
          (when (file-exists? (ciphertext-path directory name))
            (call-with-output-file file
              (lambda (port)
                (chmod file #o600)
                (put-bytevector port (secret-key secret directory identity)))))
          (let ((status (system* "sh" "-c"
                                 (string-append editor " \"$1\"")
                                 "guix-secrets-editor" file)))
            (unless (zero? status) (error "secret editor failed" status)))
          (add-secret directory vault name (secret-kind secret)
                      (call-with-input-file file get-bytevector-all) identity)))
      (lambda () (delete-file-recursively tmp)))))
(define (show-secret directory vault name identity)
  (let ((secret (find (lambda (s) (eq? (secret-name s) name)) (vault-secrets vault))))
    (unless secret (error "unknown secret" name))
    (secret-key secret directory identity)))
(define (list-secrets vault) (map secret-name (vault-secrets vault)))
(define (rekey-vault directory vault identity)
  "Decrypt before replacing any file; re-encrypt to the current recipients."
  (let ((plain (map (lambda (s) (cons s (secret-key s directory identity)))
                    (vault-secrets vault))))
    (for-each (lambda (entry)
                (let ((s (car entry)) (text (cdr entry)))
                  (write-secret directory (secret-name s) text
                                (map (lambda (r) (assq-ref (vault-recipients vault) r))
                                     (secret-recipients s))))) plain)))
(define (exec-with-secrets directory vault identity command)
  "Run COMMAND with plaintext only in a private directory, removed on exit."
  (let ((tmp (private-temporary-directory "")))
    (chmod tmp #o700)
    (define old-signals '())
    (define child-pid #f)
    (define (cleanup)
      (when (file-exists? tmp) (delete-file-recursively tmp)))
    (define (restore-signals)
      (for-each (lambda (entry)
                  (sigaction (car entry) (cadr entry) (cddr entry))) old-signals))
    (dynamic-wind
      (lambda ()
        (for-each (lambda (signal)
                    (set! old-signals (cons (cons signal (sigaction signal #f)) old-signals))
                    (sigaction signal
                      (lambda (signum)
                        (restore-signals)
                        (when child-pid (kill child-pid signum))
                        (cleanup)
                        (kill (getpid) signum))))
                  (list SIGINT SIGTERM SIGHUP)))
      (lambda ()
        (for-each (lambda (s)
                    (call-with-output-file (string-append tmp "/" (symbol->string (secret-name s)))
                      (lambda (p) (chmod (port-filename p) (secret-mode s))
                               (put-bytevector p (secret-key s directory identity)))))
                  (vault-secrets vault))
        (setenv "GUIX_SECRETS_DIRECTORY" tmp)
        (let ((pid (primitive-fork)))
          (set! child-pid pid)
          (if (zero? pid)
              (begin (apply execlp (car command) command) (primitive-exit 127))
              (let* ((wait (waitpid pid))
                     (status (cdr wait)))
                (set! child-pid #f)
                (or (status:exit-val status)
                    (let ((signal (status:term-sig status)))
                      (and signal (+ 128 signal))))))))
      (lambda () (restore-signals) (cleanup) (unsetenv "GUIX_SECRETS_DIRECTORY")))))
(define (recipient-stanza-matches? recipient stanza)
  (match (cons recipient stanza)
    (((name . key) "X25519" (ephemeral) body)
     (and (not (string-prefix? "ssh-ed25519 " key))
          (= 32 (bytevector-length body))))
    (((name . key) "ssh-ed25519" (fingerprint ephemeral) body)
     (and (string-prefix? "ssh-ed25519 " key)
          (string=? fingerprint (ssh-recipient-fingerprint key))
          (= 32 (bytevector-length body))))
    (_ #f)))
(define (private-key-file? file)
  (and (not (string-suffix? ".go" file))
       (not (string-suffix? ".age" file))
       (not (string-suffix? ".pub" file))
       (eq? 'regular (stat:type (stat file #f)))
       (false-if-exception
        (let ((port (open-input-file file)))
          (let ((text (get-bytevector-n port 4096)))
            (close-port port)
            (let ((text (bytevector->string text "ISO-8859-1")))
              (or (parse-x25519-identity text)
                  (string-prefix? "-----BEGIN OPENSSH PRIVATE KEY-----" text))))))))
(define (project-files-to-check directory)
  (if (file-exists? (string-append directory "/.git"))
      (let* ((port (open-pipe* OPEN_READ "git" "-C" directory
                               "ls-files" "-z" "--" "."))
             (names (remove string-null?
                            (string-split (get-string-all port) #\nul)))
             (status (close-pipe port)))
        (unless (zero? status)
          (error "cannot enumerate tracked project tree" directory))
        (map (lambda (name) (string-append directory "/" name)) names))
      (find-files directory
                  (lambda (file stat) (eq? 'regular (stat:type stat))))))
(define* (check-vault directory vault identity #:key (project-directory #f))
  (for-each (lambda (s)
              (let* ((ciphertext (read-secret-file directory (secret-name s)))
                     (stanzas (age-header-stanzas ciphertext))
                     (plaintext (secret-key s directory identity)))
                (unless (and (= (length stanzas) (length (secret-recipients s)))
                             (every recipient-stanza-matches?
                                    (map (lambda (name)
                                           (or (assq name (vault-recipients vault))
                                               (error "unknown secret recipient" name)))
                                         (secret-recipients s))
                                    stanzas))
                  (error "recipient stanzas differ from vault" (secret-name s)))
                (when (eq? 'ssh-key (secret-kind s))
                  (let ((path (public-path directory (secret-name s))))
                    (unless (file-exists? path) (error "missing public half" (secret-name s)))
                    (let ((expected (ssh-identity-public-text
                                     (read-ssh-identity-text (utf8->string plaintext))))
                          (actual (call-with-input-file path get-string-all)))
                      (unless (string=? expected actual)
                        (error "public half does not match private key" (secret-name s))))))))
            (vault-secrets vault))
  (when project-directory
    (for-each
     (lambda (file)
       (when (private-key-file? file)
         (error "tracked file contains a private key" file)))
     (project-files-to-check project-directory)))
  #t)
(define (write-local-option directory name value)
  "Set one public option, preserving data-only local input overrides."
  (let* ((file (string-append directory "/flake.local.scm"))
         (form (if (file-exists? file)
                   (call-with-input-file file read-data-port)
                   '(flake-local (version 1))))
         (inputs (match (assq 'inputs (cdr form)) ((_ . values) values) (#f '())))
         (options (match (assq 'options (cdr form)) ((_ . values) values) (#f '())))
         (options (cons (list name value)
                        (remove (lambda (entry) (eq? name (car entry))) options))))
    (unless (match form (('flake-local ('version 1) members ...) #t) (_ #f))
      (error "unsupported local-options file" file))
    (mkdir-p directory)
    (with-atomic-file-output file
      (lambda (port)
        (write `(flake-local (version 1) (inputs ,@inputs) (options ,@options)) port)
        (newline port)))))
